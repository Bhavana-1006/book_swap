# ==========================================
# BookSwap Backend Environment Variables
# ==========================================

# Port for Express server (Default: 5000)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/bookswap
# MongoDB Atlas Cloud (Uncomment and replace with your credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bookswap?retryWrites=true&w=majority

# Secret key for JWT token signing & verification
JWT_SECRET=super_secret_bookswap_jwt_key_2026_xyz

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Google Books API Key (Optional - ISBN lookup works without key using standard public quota)
GOOGLE_BOOKS_API_KEY=
